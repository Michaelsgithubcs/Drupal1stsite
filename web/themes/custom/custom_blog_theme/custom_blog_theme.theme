<?php

/**
 * @file
 * Functions to support theming in the Custom Blog Theme.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function custom_blog_theme_preprocess_node(&$variables) {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  
  // Add custom variables for blog post nodes
  if ($node->bundle() == 'blog_post') {
    $variables['author_name'] = $node->getOwner()->getDisplayName();
    $variables['date'] = \Drupal::service('date.formatter')->format(
      $node->getCreatedTime(),
      'custom',
      'F j, Y'
    );
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for node templates.
 */
function custom_blog_theme_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  $node = $variables['elements']['#node'];
  $view_mode = $variables['elements']['#view_mode'];
  
  // Add suggestions based on content type and view mode
  $suggestions[] = 'node__' . $node->bundle() . '__' . $view_mode;
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function custom_blog_theme_preprocess_page(&$variables) {
  // Add custom classes or variables for pages
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    if ($node instanceof NodeInterface) {
      $variables['node_type'] = $node->bundle();
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for field templates.
 */
function custom_blog_theme_preprocess_field(&$variables) {
  $element = $variables['element'];
  
  // Custom preprocessing for tags field
  if ($element['#field_name'] == 'field_tags') {
    $variables['attributes']['class'][] = 'tags-list';
  }
}
